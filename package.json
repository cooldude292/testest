{
  "name": "flowtunnel",
  "productName": "FlowTunnel",
  "version": "1.1.0",
  "description": "Real-time wind tunnel and water tank. Drop in a 3D model, get drag, lift, buoyancy and live flow fields.",
  "main": "main.js",
  "author": "cooldude292",
  "license": "MIT",
  "private": true,
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "prestart": "npm run vendor",
    "start": "electron .",
    "serve": "npm run vendor && http-server src -p 8080 -c-1",
    "predist": "npm run vendor",
    "dist": "electron-builder --mac dir --universal --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "three": "^0.186.1"
  },
  "build": {
    "appId": "com.cooldude292.flowtunnel",
    "productName": "FlowTunnel",
    "directories": { "buildResources": "build" },
    "files": [
      "main.js",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": null
    }
  }
}
